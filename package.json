{
  "name": "finance-local-workbench",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env.local dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:contracts": "tsx scripts/verify-data.ts",
    "doctor": "tsx scripts/manage.ts doctor",
    "service:install": "tsx scripts/manage.ts install",
    "service:uninstall": "tsx scripts/manage.ts uninstall",
    "backup": "tsx scripts/manage.ts backup",
    "restore": "tsx scripts/manage.ts restore",
    "security:scan": "node scripts/scan-secrets.mjs",
    "open": "tsx scripts/manage.ts open",
    "service:start": "tsx scripts/manage.ts start",
    "service:stop": "tsx scripts/manage.ts stop",
    "notification:bridge": "tsx scripts/notification-bridge.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "verify:api": "node --import tsx scripts/verify-api.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.8",
    "@napi-rs/keyring": "^1.2.0",
    "cheerio": "^1.1.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.0.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
